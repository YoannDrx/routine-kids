        }
      }
    },
    "Paiement via votre identifiant Apple. Renouvellement automatique sauf résiliation au moins 24 h avant l’échéance.": {
      "localizations": {
        "en": {
          "stringUnit": { "state": "translated", "value": "Payment is charged to your Apple ID. Auto-renews unless cancelled at least 24 hours before renewal." }
