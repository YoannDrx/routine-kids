NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-before-production

# Transactional authentication email (required in production).
RESEND_API_KEY=re_...
EMAIL_FROM=RoutineKids <parents@your-domain.example>
NEXT_PUBLIC_SUPPORT_EMAIL=support.routinekids@gmail.com

# Dedicated Neon database for routine-kids.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Private Vercel Blob store used for child and task images.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Stripe Billing (configure test-mode values before local checkout testing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
STRIPE_FAMILY_PLUS_MONTHLY_PRICE_ID=
STRIPE_FAMILY_PLUS_YEARLY_PRICE_ID=

# Keep false until the complete live-payment recipe and launch checklist pass.
# Preview and local runtimes remain usable for test-mode Checkout.
COMMERCIAL_SALES_ENABLED=false
# Optional comma-separated allowlist for controlled live production tests.
COMMERCIAL_SALES_TESTER_EMAILS=

# App Store / StoreKit 2 (required before the iOS subscription is enabled).
APPLE_APP_BUNDLE_ID=com.yoannandrieux.routinekids
APPLE_APP_ID=
APPLE_FAMILY_PLUS_MONTHLY_PRODUCT_ID=com.yoannandrieux.routinekids.familyplus.monthly
APPLE_FAMILY_PLUS_YEARLY_PRODUCT_ID=com.yoannandrieux.routinekids.familyplus.yearly
# JSON array containing Apple's DER root certificates encoded as base64 strings.
APPLE_ROOT_CERTIFICATES_BASE64=[]
