NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-before-production

# Dedicated Neon database for routine-kids.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Private Vercel Blob store used for child and task images.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Stripe Billing (configure test-mode values before local checkout testing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FAMILY_PLUS_MONTHLY_PRICE_ID=
STRIPE_FAMILY_PLUS_YEARLY_PRICE_ID=
