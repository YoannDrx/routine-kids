generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AgeBand {
  MINI
  GROWING
  BIG
}

enum UiTone {
  SPACE
  OCEAN
  JUNGLE
  PASTEL
}

enum RoutinePeriod {
  MORNING
  AFTER_SCHOOL
  EVENING
  BEDTIME
  WEEKEND
}

enum BillingPlan {
  FREE
  FAMILY
  FAMILY_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  role             String?
  banned           Boolean?
  banReason        String?
  banExpires       DateTime?
  stripeCustomerId String?   @unique

  sessions         Session[]
  accounts         Account[]
  subscription     Subscription?
  household        Household?              @relation("HouseholdOwner")
  securitySettings ParentSecuritySettings?
  auditLogs        AdminAuditLog[]         @relation("AuditActor")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Subscription {
  id                   String             @id
  plan                 BillingPlan        @default(FREE)
  referenceId          String             @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               SubscriptionStatus? @default(ACTIVE)
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean?           @default(false)

  user User @relation(fields: [referenceId], references: [id], onDelete: Cascade)
}

model Household {
  id                 String                   @id @default(cuid())
  name               String
  ownerUserId        String                   @unique
  locale             String                   @default("fr")
  soundsEnabled      Boolean                  @default(true)
  morningStart       String                   @default("06:00")
  morningEnd         String                   @default("12:00")
  eveningStart       String                   @default("18:00")
  eveningEnd         String                   @default("21:00")
  isOnboarded        Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  owner              User                     @relation("HouseholdOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  childProfiles      ChildProfile[]
  routines           Routine[]
  taskTemplates      TaskTemplate[]
  activityLogs       ActivityLog[]
  adminAuditLogs     AdminAuditLog[]
  suggestionPresets  RoutineSuggestionPreset[]
  themePacks         ThemePack[]
}

model ParentSecuritySettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  adminPinHash     String?
  stepUpMinutes    Int      @default(15)
  passkeyEnabled   Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChildProfile {
  id             String    @id @default(cuid())
  householdId    String
  defaultThemeId String?
  name           String
  age            Int
  ageBand        AgeBand
  tone           UiTone
  avatar         String?
  photoUrl       String?
  headline       String?
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  defaultTheme     ThemePack?      @relation(fields: [defaultThemeId], references: [id], onDelete: SetNull)
  routines         Routine[]
  taskCompletions  TaskCompletion[]
  activityLogs     ActivityLog[]

  @@index([householdId, order])
}

model Routine {
  id                 String        @id @default(cuid())
  householdId        String
  childProfileId     String?
  suggestionPresetId String?
  title              String
  period             RoutinePeriod
  ageMin             Int
  ageMax             Int
  isTemplate         Boolean       @default(false)
  isArchived         Boolean       @default(false)
  order              Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  household        Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  childProfile     ChildProfile?            @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  suggestionPreset RoutineSuggestionPreset? @relation(fields: [suggestionPresetId], references: [id], onDelete: SetNull)
  tasks            RoutineTask[]

  @@index([householdId, period, order])
  @@index([childProfileId, period])
}

model RoutineTask {
  id              String    @id @default(cuid())
  routineId       String
  templateId      String?
  title           String
  shortLabel      String?
  icon            String?
  imageUrl        String?
  color           String?
  scheduleDays    Json?
  durationMinutes Int?
  points          Int       @default(1)
  isRequired      Boolean   @default(true)
  rewardType      String?
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  routine      Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  template     TaskTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  completions  TaskCompletion[]

  @@index([routineId, order])
}

model TaskCompletion {
  id             String   @id @default(cuid())
  taskId         String
  childProfileId String
  dayKey         String
  completedAt    DateTime @default(now())
  streakSnapshot Int?
  metadata       Json?

  task         RoutineTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  childProfile ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([taskId, childProfileId, dayKey])
  @@index([childProfileId, completedAt])
}

model TaskTemplate {
  id                 String    @id @default(cuid())
  householdId        String?
  title              String
  shortLabel         String?
  icon               String?
  durationMinutes    Int?
  imageUrl           String?
  color              String?
  category           String?
  minAge             Int?
  maxAge             Int?
  autoAssignEnabled  Boolean   @default(true)
  isBuiltIn          Boolean   @default(false)
  recommendationMeta Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  household Household?    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tasks     RoutineTask[]

  @@index([householdId, title])
}

model ThemePack {
  id           String    @id @default(cuid())
  householdId  String?
  slug         String
  name         String
  tone         UiTone
  description  String?
  accentColor  String
  surfaceColor String
  ageBand      AgeBand?
  isPremium    Boolean   @default(false)
  isBuiltIn    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  household    Household?    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  childProfiles ChildProfile[]

  @@index([householdId, slug])
}

model RoutineSuggestionPreset {
  id          String        @id @default(cuid())
  householdId String?
  title       String
  description String
  ageMin      Int
  ageMax      Int
  period      RoutinePeriod
  tone        UiTone
  tasks       Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  routines  Routine[]

  @@index([householdId, period, ageMin, ageMax])
}

model ActivityLog {
  id             String    @id @default(cuid())
  householdId     String
  childProfileId  String?
  eventType       String
  title           String
  metadata        Json?
  createdAt       DateTime @default(now())

  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  childProfile ChildProfile? @relation(fields: [childProfileId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  householdId  String
  actorUserId  String
  action       String
  targetType   String
  targetId     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor     User      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@index([actorUserId, createdAt])
}
